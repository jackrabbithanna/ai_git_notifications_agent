<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="gitinbox"
        Arguments=""
        InstallLocation="C:\Program Files\gitinbox\GitInbox">
    </Installer>
    <PackageInformation
        PackageName="GitInbox"
        PackageDisplayName="GitInbox"
        PublisherName="CN=gitinbox"
        PublisherDisplayName="gitinbox"
        Version="0.1.0.0"
        PackageDescription="AI-triaged GitHub notifications dashboard">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.gitinbox.app"
                Description="AI-triaged GitHub notifications dashboard"
                DisplayName="GitInbox"
                ExecutableName="gitinbox"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>GitInbox</DisplayName>
            <PublisherDisplayName>gitinbox</PublisherDisplayName>
            <Description>AI-triaged GitHub notifications dashboard</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="gitinbox.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
